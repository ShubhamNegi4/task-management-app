<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Delete: <%= note.Title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-red-50 min-h-screen text-gray-800 font-sans">
  <div class="max-w-2xl mx-auto px-6 py-12">
    <a href="/" class="text-indigo-600 hover:underline mb-6 inline-block">&larr; Back to Home</a>

    <div class="bg-white shadow-md rounded-lg p-6">
      <h1 class="text-2xl font-bold text-red-600 mb-4">Delete This Note?</h1>

      <div class="mb-6">
        <h2 class="text-xl font-semibold text-gray-900"><%= note.Title %></h2>
        <p class="mt-2 text-gray-700 whitespace-pre-wrap"><%= note.Description %></p>
      </div>

      <form action="/delete" method="POST" class="flex justify-between items-center">
        <input type="hidden" name="title" value="<%= note.Title %>">
        <button
          type="submit"
          class="bg-red-600 text-white px-5 py-2 rounded-md hover:bg-red-500 transition"
        >
          Yes, Delete It
        </button>
        <a
          href="/file/<%= note.Title %>"
          class="text-gray-600 hover:underline"
        >
          Cancel
        </a>
      </form>
    </div>
  </div>
</body>
</html>
