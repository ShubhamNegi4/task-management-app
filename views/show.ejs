<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title><%= note.Title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-cream-50 antialiased font-sans">
  <div class="min-h-screen flex items-center justify-center p-6">
    <div class="w-full max-w-2xl bg-white rounded-2xl shadow-lg p-8 animate-fadeIn">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-3xl font-bold text-gray-800"><%= note.Title %></h1>
        <a href="/" class="text-indigo-600 hover:text-indigo-500 transition">← Home</a>
      </div>
      <p class="text-gray-700 text-lg leading-relaxed whitespace-pre-wrap">Url : <%= note.Bookmarks %></p>
      <p class="text-gray-700 text-lg leading-relaxed whitespace-pre-wrap">Description : <%= note.Description %></p>
    </div>
  </div>

  <style>
    .bg-cream-50 { background-color: #fdfdf7; }
    @keyframes fadeIn { from { opacity: 0; transform: scale(0.95);} to { opacity: 1; transform: scale(1);} }
    .animate-fadeIn { animation: fadeIn 0.4s ease-out both; }
  </style>
</body>
</html>
